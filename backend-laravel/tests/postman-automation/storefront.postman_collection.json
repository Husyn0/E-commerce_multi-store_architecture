  "item": [
    {
      "name": "01 Tenant and public catalog",
      "description": "Public requests; no login is needed.",
      "item": [
        {
          "name": "Storefront tenant resolves",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/storefront/tenant",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "storefront",
                "tenant"
              ],
              "query": []
            },
            "description": "Uses the Storefront tenant hostname. Confirms the host resolves to the intended tenant."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Storefront tenant resolves', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Request used the Storefront host', () => pm.expect(data.host_type).to.eql('storefront'));",
                  "pm.test('Tenant is active', () => pm.expect(data.status).to.eql('active'));",
                  "pm.collectionVariables.set('tenantId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List catalog categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/storefront/catalog/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "storefront",
                "catalog",
                "categories"
              ],
              "query": []
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Storefront categories load', () => pm.response.to.have.status(200));",
                  "pm.test('Categories response is JSON', () => pm.expect(pm.response.json()).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List catalog products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/storefront/catalog/products?per_page=10&page=1",
              "host": [
