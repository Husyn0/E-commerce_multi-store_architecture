              "query": []
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Saved payment methods load', () => pm.response.to.have.status(200));",
                  "pm.test('Methods response has a data array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Customer logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-CSRF-TOKEN",
                "value": "{{storeCsrf}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/storefront/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
