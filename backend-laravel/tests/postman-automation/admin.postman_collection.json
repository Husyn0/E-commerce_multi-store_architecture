                "type": "text/javascript",
                "exec": [
                  "pm.test('Dashboard loads', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Dashboard includes period and sales summary', () => {",
                  "  pm.expect(data.period).to.be.an('object');",
