        {
          "name": "Delete this run product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/products/{{createdProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
