    {
      "name": "01 Tenant and authentication",
      "description": "Run sequentially. Login exports the access token used by later requests.",
      "item": [
        {
          "name": "Tenant resolves on Admin host",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tenant",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "tenant"
              ],
              "query": []
            },
            "description": "Public tenant/host smoke test. This collection must use the Admin tenant hostname."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin tenant resolves', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Request used the Admin host', () => pm.expect(data.host_type).to.eql('admin'));",
                  "pm.test('Tenant is active', () => pm.expect(data.status).to.eql('active'));",
                  "pm.collectionVariables.set('tenantId', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject protected request without token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "products"
              ],
              "query": []
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Confirms Admin resources reject unauthenticated requests."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Protected Admin endpoint requires authentication', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "login"
              ],
              "query": []
            },
            "description": "Uses adminEmail/adminPassword from the selected Admin environment. The access token is kept in collection variables.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{adminEmail}}\",\"password\":\"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Response includes a Bearer token', () => {",
                  "  pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "  pm.expect(data.token_type).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('adminAccessToken', data.access_token);",
                  "const setCookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value);",
                  "const csrf = setCookies.map(v => v.match(/(?:^|;\\s*)admin_csrf=([^;]+)/i)).find(Boolean);",
                  "if (csrf) pm.collectionVariables.set('adminCsrf', decodeURIComponent(csrf[1]));"
                ]
              }
            }
          ]
        },
