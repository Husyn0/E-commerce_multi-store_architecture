              "mode": "raw",
              "raw": "{\"title\":\"Postman Product {{runId}}\",\"slug\":\"postman-{{runId}}\",\"description\":\"Created by the Admin Postman collection.\",\"sku\":\"PM-{{runId}}\",\"price_cents\":2599,\"is_active\":false,\"published_at\":null}",
