  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const setCookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === 'set-cookie').map(h => h.value);",
          "const csrf = setCookies.map(v => v.match(/(?:^|;\\s*)admin_csrf=([^;]+)/i)).find(Boolean);",
          "if (csrf && csrf[1]) pm.collectionVariables.set('adminCsrf', decodeURIComponent(csrf[1]));"
        ]
      }
    }
  ]
}
